# ==============================================================================
# APC-SPEECH Environment Configuration
# ==============================================================================

# Application Profile
# small: 2 vCPU / 4 GB RAM, CPU-only (ASR, VAD, Diarization, Metrics, Rules, Embeddings)
# local-full: 8 vCPU / 32 GB RAM or GPU >= 12 GB (adds local LLM runtime)
APP_PROFILE=small
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false

# HTTP Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Authentication & Security
# Токены передаются через Bearer, в БД хранятся их SHA-256 хэши
# Формат переменной: токен:scope:namespace (через запятую)
API_TOKENS_HASHED=""
# Секретный ключ для подписи callback-запросов (HMAC-SHA256)
CALLBACK_SIGNING_SECRET=change_me_to_a_secure_random_key_in_production

# PostgreSQL Connection
DATABASE_URL=postgresql+asyncpg://apc_user:secure_pass@postgres:5432/apc_speech
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Redis Infrastructure
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20

# MinIO / S3 Object Storage
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_secret_pass
S3_BUCKET_AUDIO=raw-audio
S3_BUCKET_EXPORTS=exports
S3_REGION=us-east-1

# ASR & Audio Engine Configuration
# whisper models: tiny, base, small, medium, large-v3-turbo
# Для профиля small рекомендуется: small (int8)
ASR_MODEL_NAME=small
ASR_COMPUTE_TYPE=int8
ASR_DEVICE=cpu
ASR_THREADS=2
VAD_THRESHOLD=0.5
MAX_AUDIO_DURATION_HOURS=3
MAX_UPLOAD_SIZE_MB=500

# Voice Search Fast-Track Configuration
VOICE_SEARCH_MAX_DURATION_SEC=60
VOICE_SEARCH_MODEL_NAME=small
VOICE_SEARCH_BEAM_SIZE=1

# LLM Analysis Engine Configuration
# По умолчанию используется локальный рантайм на профиле local-full
LOCAL_LLM_URL=http://llm-runtime:8080/v1
LOCAL_LLM_MODEL=qwen2.5-7b-instruct

# External LLM Provider Adapter (Strictly disabled by default!)
# Внешний ASR категорически запрещен. Внешний LLM допустим ТОЛЬКО для маскированного текста.
LLM_EXTERNAL_PROVIDER_ENABLED=false
LLM_EXTERNAL_PROVIDER_URL=""
LLM_EXTERNAL_PROVIDER_API_KEY=""

# Retention Policies (Days)
RETENTION_AUDIO_DAYS=14
RETENTION_TEXT_DAYS=365
