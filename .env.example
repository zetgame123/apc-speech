# ==============================================================================
# APC-SPEECH Environment Configuration
# ==============================================================================

# Application Profile
# small: 2 vCPU / 4 GB RAM, CPU-only (ASR, VAD, Diarization, Metrics, Rules, Embeddings)
# local-full: 8 vCPU / 32 GB RAM or GPU >= 12 GB (adds local LLM runtime)
APP_PROFILE=small
APP_ENV=production
LOG_LEVEL=INFO
DEBUG=false
# Версия сборки или Git SHA, возвращаемая GET /health
BUILD_VERSION=0.1.0

# HTTP Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Authentication & Security
# Токены передаются через Bearer, в БД хранятся их SHA-256 хэши
# Формат переменной: токен:scope:namespace (через запятую)
API_TOKENS_HASHED=""

# ВНИМАНИЕ: Токен для административного доступа без хэширования.
# В production среде должен быть не задан, либо установлен в длинную случайную строку.
DEV_TOKEN=""

# Секретный ключ для подписи callback-запросов (HMAC-SHA256, минимум 32 символа)
CALLBACK_SIGNING_SECRET=""
# Тестовый флаг E2E-проверки callback (п.9): разрешать приватные адреса ТОЛЬКО
# для исходящих callback. Выключен по умолчанию; в production включённый флаг
# блокирует старт api и worker-callback.
CALLBACK_ALLOW_PRIVATE_NET=false

# CORS Configuration
# Список разрешённых origins через запятую, "*" для разрешения всех (только для разработки)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# PostgreSQL Connection
DATABASE_URL=postgresql+asyncpg://apc_user:<CHANGE_PASSWORD>@postgres:5432/apc_speech
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# Redis Infrastructure
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20
# Таймаут чтения сокета Redis, с. Должен превышать VOICE_SEARCH_RESULT_TIMEOUT_SEC + 5,
# иначе блокирующий BLPOP рвётся ~через 5 с и быстрый путь отвечает 503.
REDIS_SOCKET_TIMEOUT_SEC=30
# Диагностические флаги быстрого пути (дефолты = штатное поведение, не менять):
# нижняя граница beam, переопределение промпта/хотвордс (пусто = выкл).
VOICE_SEARCH_BEAM_MIN=2
# VOICE_SEARCH_INITIAL_PROMPT= (пусто = выкл; unset = встроенный)
# VOICE_SEARCH_HOTWORDS= (пусто = выкл; unset = встроенные)
# Движок быстрого пути: tone (дефолт, слит) или whisper (через переменную).
# T-one — дефолтный движок голосового поиска (решение 2026-10-13, ADR-015).
VOICE_SEARCH_ENGINE=tone
TONE_MODEL_DIR=./models/t-one
# Потоки onnxruntime для T-one (1 = оптимум под 2 ядра; см. README).
TONE_THREADS=1
# Тонкие ручки ORT для замеров (дефолты = текущее поведение, не менять):
TONE_INTER_THREADS=0
TONE_GRAPH_OPT=all
TONE_DISABLE_ARENA=false
TONE_DISABLE_MEM_PATTERN=false
TONE_MODEL_FILE=model.onnx
# Порог нечётких терминов T-one (0 = выкл, дефолт; эксперимент п.13: вредит).
TONE_FUZZY_THRESHOLD=0.0
# п.3а: замена только для слов вне словаря navec (дефолт выкл).
# TONE_FUZZY_OOV_ONLY=false
# п.3б: декодер T-one (greedy дефолт), ширина и вес beam с хотвордами.
# TONE_DECODE=greedy
# TONE_BEAM_WIDTH=10
# TONE_HOTWORD_WEIGHT=3.0
# MinIO / S3 Object Storage
# Пустые S3_ACCESS_KEY/S3_SECRET_KEY = дефолты minio_admin/minio_secret_pass
# (должны совпадать с MINIO_ROOT_USER/MINIO_ROOT_PASSWORD ниже).
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET_AUDIO=raw-audio
S3_BUCKET_EXPORTS=exports
S3_REGION=us-east-1

# ASR & Audio Engine Configuration
# whisper models: tiny, base, small, medium, large-v3-turbo
# Для профиля small рекомендуется: small (int8)
ASR_MODEL_NAME=./models/whisper-podlodka-turbo-ct2
ASR_COMPUTE_TYPE=int8
ASR_DEVICE=cpu
ASR_THREADS=2
VAD_THRESHOLD=0.5
MAX_AUDIO_DURATION_HOURS=3
MAX_UPLOAD_SIZE_MB=500
# Максимум заданий в статусах queued/running; сверх лимита API отвечает 429 с Retry-After
MAX_PENDING_JOBS=100
# Возраст pending_download-задания, после которого уборщик переводит его в failed с callback
PENDING_DOWNLOAD_TIMEOUT_SEC=600

# Voice Search Fast-Track Configuration
VOICE_SEARCH_MAX_DURATION_SEC=60
VOICE_SEARCH_MODEL_NAME=small
VOICE_SEARCH_BEAM_SIZE=1
# Максимум одновременно обрабатываемых синхронных запросов; при переполнении возвращается 503
VOICE_SEARCH_MAX_CONCURRENCY=1
# Максимальное ожидание свободного слота обработки, секунды
VOICE_SEARCH_QUEUE_WAIT_SEC=0.1
# Отдельная Redis-очередь worker-fast (обязательна в Docker-профилях)
VOICE_SEARCH_USE_WORKER=true
VOICE_SEARCH_RESULT_TIMEOUT_SEC=2.5

# LLM Analysis Engine Configuration
# По умолчанию используется локальный рантайм на профиле local-full
LOCAL_LLM_URL=http://llm-runtime:8080/v1
LOCAL_LLM_MODEL=qwen2.5-7b-instruct
# Потоки llama.cpp server (-t/--threads-batch) для профиля local-full, дефолт 4.
# Замер 2026-10-13 (Ryzen 7 8845HS, 8 физических ядер, Qwen2.5-7B Q4_K_M,
# reports/llm_threads_sweep_2026-10-13.json): -t 4 медиана 27,0 с; -t 6 медиана
# 25,8 с; -t 8 медиана 37,7 с. На хосте с 8 и более физическими ядрами можно 6.
# Больше числа физических ядер ставить хуже (оверподписка: -t 8 на 8 ядрах дал
# 37,7 с против 25,8 с при -t 6). Ориентир разбора <= 30 с выполнен на 8
# физических ядрах (замер; прежний вывод про «только GPU» был ошибкой: замер шёл
# с -t 2 при 8 vCPU, CPU недогружался).
LLAMA_THREADS=4

# External LLM Provider Adapter (Strictly disabled by default!)
# Внешний ASR категорически запрещен. Внешний LLM допустим ТОЛЬКО для маскированного текста.
LLM_EXTERNAL_PROVIDER_ENABLED=false
LLM_EXTERNAL_PROVIDER_URL=""
LLM_EXTERNAL_PROVIDER_API_KEY=""
# Модель внешнего провайдера аналитики (только маскированный текст, см. C7).
# Адаптер выключен по умолчанию (ENABLED=false).
LLM_EXTERNAL_PROVIDER_MODEL="gpt-4o-mini"

# Retention Policies (Days)
RETENTION_AUDIO_DAYS=14
RETENTION_TEXT_DAYS=365

# Rate Limiting
# Default: 5 requests per 10 seconds. In dev/testing recommended: 30
RATE_LIMIT_REQUESTS_PER_WINDOW=5
RATE_LIMIT_WINDOW_SEC=10

# Docker Compose infrastructure variables (empty = compose defaults apply).
# DB_USER/DB_PASSWORD задают пользователя Postgres (должны совпадать с DATABASE_URL),
# MINIO_ROOT_USER/MINIO_ROOT_PASSWORD — root-доступ MinIO (совпадают с S3-ключами).
DB_USER=""
DB_PASSWORD=""
MINIO_ROOT_USER=""
MINIO_ROOT_PASSWORD=""
# Переопределение образа MinIO для закрытого registry (по умолчанию digest-пин в compose).
MINIO_IMAGE=""
# Токен Hugging Face для model-downloader (нужен только для приватных/gated-моделей).
HF_TOKEN=""

# Diarization tuning
DIARIZATION_MIN_SPEAKER_DISTANCE=0.18

